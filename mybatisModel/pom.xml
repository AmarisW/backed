<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- 父类信息 -->
  <parent>
    <artifactId>IndividualProject</artifactId>
    <groupId>com.gqtian</groupId>
    <version>${revision}</version>
  </parent>


  <!-- 模块信息 -->
  <artifactId>mybatisModel</artifactId>
  <name>mybatisModel</name>
  <version>${revision}</version>
  <description>初始化模板信息</description>

  <!-- 打包方式 -->
  <packaging>jar</packaging>

  <!-- 依赖版本控制 -->
  <properties>
  </properties>

  <!-- 依赖控制 -->
  <dependencies>
    <dependency>
      <artifactId>commonModel</artifactId>
      <groupId>com.gqtian</groupId>
    </dependency>


    <!--===============================数据库连接===========================-->
    <!-- 动态数据源 -->
    <dependency>
      <artifactId>dynamic-datasource-spring-boot3-starter</artifactId>
      <groupId>com.baomidou</groupId>
    </dependency>

    <!-- Druid 连接池 -->
    <dependency>
      <artifactId>druid-spring-boot-starter</artifactId>
      <groupId>com.alibaba</groupId>
    </dependency>

    <!-- 数据库驱动 -->
    <dependency>
      <artifactId>mysql-connector-j</artifactId>
      <groupId>com.mysql</groupId>
    </dependency>
  </dependencies>


  <!-- 构建信息-->
  <build>
    <plugins>
      <plugin>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <artifactId>spring-boot-configuration-processor</artifactId>
              <groupId>org.springframework.boot</groupId>
            </exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
        <groupId>org.springframework.boot</groupId>
      </plugin>
      <plugin>
        <artifactId>git-commit-id-maven-plugin</artifactId>
        <groupId>io.github.git-commit-id</groupId>
      </plugin>

      <!-- 解压插件：将本地脚本包解压到 target 目录 -->
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>unzip-script-jar</id>
            <phase>package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <unzip dest="target" src="${project.basedir}/../abientLib/script-jar-main.zip"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Assembly插件：自定义打包格式，生成发布包 -->
      <plugin>
        <artifactId>maven-assembly-plugin</artifactId>
        <configuration>
          <descriptors>
            <descriptor>${project.basedir}/../abientLib/assembly.xml</descriptor>
          </descriptors>
        </configuration>
        <executions>
          <execution>
            <id>make-assembly</id>
            <goals>
              <goal>single</goal>
            </goals>
            <phase>package</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

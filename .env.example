# 复制为仓库根目录的 .env 后填入本地值。
# .env 已在 .gitignore 中，不会进入 Git。
# 在仓库根目录或各个模块目录启动时，Spring 会读取这个文件。

# 多个模块共用的 MySQL 密码
MYSQL_PASSWORD=

# Redis 密码
REDIS_PASSWORD=

# easyTrans 模块 MySQL 密码
EASY_TRANS_MYSQL_PASSWORD=

# easyTrans 模块 Redis 密码
EASY_TRANS_REDIS_PASSWORD=

# RabbitMQ 密码
RABBITMQ_PASSWORD=

# RocketMQ AccessKey
ROCKETMQ_ACCESS_KEY=

# RocketMQ SecretKey
ROCKETMQ_SECRET_KEY=

# MinIO AccessKey
MINIO_ACCESS_KEY=

# MinIO SecretKey
MINIO_SECRET_KEY=

# 阿里云 OSS AccessKey ID
ALIYUN_OSS_ACCESS_KEY=

# 阿里云 OSS AccessKey Secret
ALIYUN_OSS_SECRET_KEY=

# 华为 OBS AccessKey
HUAWEI_OBS_ACCESS_KEY=

# 华为 OBS SecretKey
HUAWEI_OBS_SECRET_KEY=

# FTP 用户名
FTP_USERNAME=

# FTP 密码
FTP_PASSWORD=

# JWT 签名密钥
JWT_SECRET=

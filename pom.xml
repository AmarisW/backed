<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- parent指明继承关系，给出被继承的父项目的具体信息 设置全局springboot版本-->
  <parent>
    <artifactId>spring-boot-starter-parent</artifactId>
    <groupId>org.springframework.boot</groupId>
    <relativePath/>
    <version>3.5.3</version>
  </parent>

  <!-- 项目信息 -->
  <artifactId>IndividualProject</artifactId>
  <groupId>com.gqtian</groupId>
  <name>IndividualProject</name>
  <version>${revision}</version>
  <description>构建个人多模块化体系</description>

  <!-- 多模块项目父工程必须指定为 pom -->
  <packaging>pom</packaging>

  <!-- 模块说明：这里声明多个子模块 -->
  <modules>
    <module>annotationModel</module>
    <module>commonModel</module>
    <module>nettyModel</module>
    <module>contrastModel</module>
    <module>fileStorageModel</module>
    <module>logViewModel</module>
    <module>rocketClientModel</module>
    <module>rocketSpringModel</module>
    <module>hbaseModel</module>
    <module>networkModel</module>
    <module>redisModel</module>
    <module>mybatisModel</module>
  </modules>


  <!-- 版本控制 -->
  <properties>

    <!-- 全局项目版本控制 Start -->
    <revision>1.0.0</revision>
    <!-- 全局项目版本控制 End -->

    <commons-lang3.version>3.18.0</commons-lang3.version>
    <commons-net.version>3.9.0</commons-net.version>
    <druid.version>1.2.18</druid.version>
    <easyexcel.version>3.2.1</easyexcel.version>
    <fastjson2.version>2.0.43</fastjson2.version>
    <guava.version>33.4.8-jre</guava.version>
    <hutool.version>5.8.24</hutool.version>
    <jsch.version>0.1.55</jsch.version>
    <jts-core.version>1.20.0</jts-core.version>
    <jyaml.version>1.3</jyaml.version>
    <mybatis-plus.version>3.5.9</mybatis-plus.version>
    <mybatis-plus-jsqlparser.version>3.5.9</mybatis-plus-jsqlparser.version>
    <mysql.version>8.2.0</mysql.version>
    <netty.version>4.1.94.Final</netty.version>
    <obs-aliyun.version>3.15.1</obs-aliyun.version>
    <obs-hw.version>3.22.12</obs-hw.version>
    <obs-minio.version>8.2.1</obs-minio.version>
    <ali-hbase.version>1.8.7</ali-hbase.version>
    <rocketmq-client.version>4.9.2</rocketmq-client.version>
    <rocketmq-spring.version>2.3.3</rocketmq-spring.version>
    <javacv.version>1.5.9</javacv.version>
    <ffmpeg-win.version>6.0-1.5.9</ffmpeg-win.version>
    <ffmpeg-linux.version>6.0-1.5.9</ffmpeg-linux.version>
    <spring-data-redis.version>3.5.8</spring-data-redis.version>
    <spring-data-redisson.version>3.52.0</spring-data-redisson.version>
    <redisson.version>3.52.0</redisson.version>
    <jackson-datatype-jsr310.version>2.13.0</jackson-datatype-jsr310.version>
  </properties>

  <!-- 项目依赖统一管理 -->
  <dependencyManagement>
    <!--============================ 子包依赖 ============================-->
    <dependencies>
      <dependency>
        <artifactId>commonModel</artifactId>
        <groupId>com.gqtian</groupId>
        <version>${revision}</version>
      </dependency>

      <dependency>
        <artifactId>fileStorageModel</artifactId>
        <groupId>com.gqtian</groupId>
        <version>${revision}</version>
      </dependency>

      <!--============================ Spring ============================-->

      <dependency>
        <artifactId>netty-all</artifactId>
        <groupId>io.netty</groupId>
        <version>${netty.version}</version>
      </dependency>

      <!--============================ 数据源 ============================-->
      <!-- Mybatis-Plus -->
      <dependency>
        <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        <groupId>com.baomidou</groupId>
        <version>${mybatis-plus.version}</version>
      </dependency>

      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-jsqlparser</artifactId>
        <version>${mybatis-plus-jsqlparser.version}</version>
      </dependency>

      <!-- Druid连接池 -->
      <dependency>
        <artifactId>druid-spring-boot-starter</artifactId>
        <groupId>com.alibaba</groupId>
        <version>${druid.version}</version>
      </dependency>

      <!-- MySQL驱动 -->
      <dependency>
        <artifactId>mysql-connector-j</artifactId>
        <groupId>com.mysql</groupId>
        <version>${mysql.version}</version>
      </dependency>


      <!--============================ Redis依赖 ============================-->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-data-redis</artifactId>
        <version>${spring-data-redis.version}</version>
      </dependency>

      <dependency>
        <groupId>org.redisson</groupId>
        <artifactId>redisson-spring-boot-starter</artifactId>
        <version>${spring-data-redisson.version}</version>
      </dependency>

      <dependency>
        <groupId>org.redisson</groupId>
        <artifactId>redisson</artifactId>
        <version>${redisson.version}</version>
      </dependency>


      <!-- 解决在实体类使用java.time包下的LocalDateTime、LocalDate等类时序列化/反序列化报错的问题 -->
      <dependency>
        <groupId>com.fasterxml.jackson.datatype</groupId>
        <artifactId>jackson-datatype-jsr310</artifactId>
        <version>${jackson-datatype-jsr310.version}</version>
      </dependency>

      <!--============================ 存储 ============================-->

      <!--华为Obs云储存-->
      <dependency>
        <artifactId>esdk-obs-java</artifactId>
        <groupId>com.huaweicloud</groupId>
        <version>${obs-hw.version}</version>
      </dependency>

      <!-- Minio -->
      <dependency>
        <artifactId>minio</artifactId>
        <groupId>io.minio</groupId>
        <version>${obs-minio.version}</version>
      </dependency>

      <!-- Aliyun Oss -->
      <dependency>
        <artifactId>aliyun-sdk-oss</artifactId>
        <groupId>com.aliyun.oss</groupId>
        <version>${obs-aliyun.version}</version>
      </dependency>

      <!-- SFTP -->
      <dependency>
        <artifactId>jsch</artifactId>
        <groupId>com.jcraft</groupId>
        <optional>true</optional>
        <scope>provided</scope>
        <version>${jsch.version}</version>
      </dependency>

      <!-- FTP -->
      <dependency>
        <artifactId>commons-net</artifactId>
        <groupId>commons-net</groupId>
        <optional>true</optional>
        <version>${commons-net.version}</version>
      </dependency>

      <dependency>
        <artifactId>rocketmq-client</artifactId>
        <groupId>org.apache.rocketmq</groupId>
        <version>${rocketmq-client.version}</version>
      </dependency>

      <dependency>
        <artifactId>rocketmq-spring-boot-starter</artifactId>
        <groupId>org.apache.rocketmq</groupId>
        <version>${rocketmq-spring.version}</version>
      </dependency>


      <!--============================ 常用工具 ============================-->
      <!-- Lombok -->
      <dependency>
        <artifactId>lombok</artifactId>
        <groupId>org.projectlombok</groupId>
        <version>${lombok.version}</version>
      </dependency>

      <dependency>
        <artifactId>hutool-all</artifactId>
        <groupId>cn.hutool</groupId>
        <version>${hutool.version}</version>
      </dependency>

      <dependency>
        <artifactId>fastjson2</artifactId>
        <groupId>com.alibaba.fastjson2</groupId>
        <version>${fastjson2.version}</version>
      </dependency>

      <dependency>
        <artifactId>commons-pool2</artifactId>
        <groupId>org.apache.commons</groupId>
        <version>${commons-pool2.version}</version>
      </dependency>


      <dependency>
        <artifactId>commons-lang3</artifactId>
        <groupId>org.apache.commons</groupId>
        <version>${commons-lang3.version}</version>
      </dependency>


      <dependency>
        <artifactId>easyexcel</artifactId>
        <groupId>com.alibaba</groupId>
        <version>${easyexcel.version}</version>
      </dependency>

      <dependency>
        <artifactId>guava</artifactId>
        <groupId>com.google.guava</groupId>
        <version>${guava.version}</version>
      </dependency>

      <dependency>
        <artifactId>jyaml</artifactId>
        <groupId>org.jyaml</groupId>
        <version>${jyaml.version}</version>
      </dependency>

      <dependency>
        <artifactId>jts-core</artifactId>
        <groupId>org.locationtech.jts</groupId>
        <version>${jts-core.version}</version>
      </dependency>

      <dependency>
        <artifactId>alihbase-client</artifactId>
        <groupId>com.aliyun.hbase</groupId>
        <version>${ali-hbase.version}</version>
      </dependency>

      <!-- 视频抽帧功能实现 -->
      <dependency>
        <groupId>org.bytedeco</groupId>
        <artifactId>javacv</artifactId>
        <version>${javacv.version}</version>
      </dependency>

      <!-- 根据系统平台选择性导入 -->
      <dependency>
        <groupId>org.bytedeco</groupId>
        <artifactId>ffmpeg</artifactId>
        <version>${ffmpeg-win.version}</version>
        <classifier>windows-x86_64</classifier>
      </dependency>

      <!-- 根据系统平台选择性导入 -->
      <dependency>
        <groupId>org.bytedeco</groupId>
        <artifactId>ffmpeg</artifactId>
        <version>${ffmpeg-linux.version}</version>
        <classifier>linux-x86_64</classifier>
      </dependency>


    </dependencies>
  </dependencyManagement>

  <!-- 构建信息 -->
  <build>
    <plugins>
      <plugin>
        <artifactId>flatten-maven-plugin</artifactId>
        <configuration>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
          <updatePomFile>true</updatePomFile>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>flatten</goal>
            </goals>
            <id>flatten</id>
            <phase>process-resources</phase>
          </execution>
          <execution>
            <goals>
              <goal>clean</goal>
            </goals>
            <id>flatten.clean</id>
            <phase>clean</phase>
          </execution>
        </executions>
        <groupId>org.codehaus.mojo</groupId>
        <version>1.5.0</version>
      </plugin>
    </plugins>
  </build>
</project>
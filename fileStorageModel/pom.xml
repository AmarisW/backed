<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- parent指明继承关系，给出被继承的父项目的具体信息 -->
  <parent>
    <artifactId>IndividualProject</artifactId>
    <groupId>com.gqtian</groupId>
    <version>${revision}</version>
  </parent>

  <!-- 项目信息 -->
  <artifactId>fileStorageModel</artifactId>
  <name>fileStorageModel</name>
  <description>文件模块</description>

  <!-- 打包类型声明 -->
  <packaging>jar</packaging>

  <!-- 属性定义 -->
  <properties>
  </properties>

  <!-- 项目依赖 -->
  <dependencies>

    <!--============================ 子包依赖 ============================-->

    <!-- 公共基础模块 -->
    <dependency>
      <groupId>com.gqtian</groupId>
      <artifactId>commonModel</artifactId>
    </dependency>

    <!--============================ Spring Boot ============================-->
    <!-- Spring Boot 配置处理器，生成配置元数据 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <!--============================ 常用工具 ============================-->

    <!-- Apache Commons 对象池 -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-pool2</artifactId>
    </dependency>

    <!-- JSch SFTP客户端 -->
    <dependency>
      <groupId>com.jcraft</groupId>
      <artifactId>jsch</artifactId>
      <optional>true</optional>
      <scope>provided</scope>
    </dependency>

    <!-- Apache Commons Net 网络工具（FTP等） -->
    <dependency>
      <groupId>commons-net</groupId>
      <artifactId>commons-net</artifactId>
    </dependency>

    <!--============================ 其他依赖 ============================-->

    <!-- 华为云OBS对象存储 -->
    <dependency>
      <groupId>com.huaweicloud</groupId>
      <artifactId>esdk-obs-java</artifactId>
    </dependency>

    <!-- 阿里云OSS对象存储 -->
    <dependency>
      <groupId>com.aliyun.oss</groupId>
      <artifactId>aliyun-sdk-oss</artifactId>
    </dependency>

    <!-- MinIO对象存储 -->
    <dependency>
      <groupId>io.minio</groupId>
      <artifactId>minio</artifactId>
    </dependency>

    <!-- AWS S3 原生 SDK -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
    </dependency>

  </dependencies>

  <!-- 构建配置 -->
  <build>
    <plugins>
      <plugin>
        <groupId>io.github.git-commit-id</groupId>
        <artifactId>git-commit-id-maven-plugin</artifactId>
      </plugin>
      
      <!-- 解压插件：将本地脚本包解压到 target 目录 -->
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>unzip-script-jar</id>
            <phase>package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <unzip dest="target/os-rhel" src="${project.basedir}/../abientLib/rhel/script-jar-main.zip"/>
                <unzip dest="target/os-debian" src="${project.basedir}/../abientLib/debian/script-jar-main.zip"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Assembly插件：自定义打包格式，生成发布包 -->
      <plugin>
        <artifactId>maven-assembly-plugin</artifactId>
        <configuration>
          <descriptors>
            <descriptor>${project.basedir}/../abientLib/rhel/assembly-rhel.xml</descriptor>
            <descriptor>${project.basedir}/../abientLib/debian/assembly-debian.xml</descriptor>
          </descriptors>
        </configuration>
        <executions>
          <execution>
            <id>make-assembly</id>
            <goals>
              <goal>single</goal>
            </goals>
            <phase>package</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  
  <parent>
    <artifactId>IndividualProject</artifactId>
    <groupId>com.gqtian</groupId>
    <version>${revision}</version>
  </parent>

  <!-- 模块信息 -->
  <artifactId>fileStorageModel</artifactId>
  <name>fileStorageModel</name>
  <version>${revision}</version>
  <description>文件模块</description>

  <!-- 打包方式 -->
  <packaging>jar</packaging>

  <!-- 依赖控制 -->
  <properties>
  </properties>

  <!-- 依赖版本控制 -->
  <dependencies>
    <dependency>
      <artifactId>commonModel</artifactId>
      <groupId>com.gqtian</groupId>
    </dependency>

    <dependency>
      <artifactId>commons-pool2</artifactId>
      <groupId>org.apache.commons</groupId>
    </dependency>

    <!--华为Obs云储存-->
    <dependency>
      <artifactId>esdk-obs-java</artifactId>
      <groupId>com.huaweicloud</groupId>
    </dependency>

    <dependency>
      <artifactId>aliyun-sdk-oss</artifactId>
      <groupId>com.aliyun.oss</groupId>
    </dependency>

    <dependency>
      <artifactId>minio</artifactId>
      <groupId>io.minio</groupId>
    </dependency>

    <!-- SFTP -->
    <dependency>
      <artifactId>jsch</artifactId>
      <groupId>com.jcraft</groupId>
      <optional>true</optional>
      <scope>provided</scope>
    </dependency>

    <!-- FTP -->
    <dependency>
      <artifactId>commons-net</artifactId>
      <groupId>commons-net</groupId>
    </dependency>
  </dependencies>

  <!-- 父类信息 -->
  <build>
    <!-- 移除 spring-boot-maven-plugin 插件，这样就不会生成可执行jar包，只生成普通的jar包 -->
    <!--
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
    -->
    <plugins>
      <plugin>
        <artifactId>git-commit-id-maven-plugin</artifactId>
        <groupId>io.github.git-commit-id</groupId>
      </plugin>
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <configuration>
              <target>
                <unzip dest="target/jar" src="${project.basedir}/../abientLib/jar-integrate.zip"/>
              </target>
            </configuration>
            <goals>
              <goal>run</goal>
            </goals>
            <id>prepare</id>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-assembly-plugin</artifactId>
        <configuration>
          <descriptors>
            <descriptor>${project.basedir}/../abientLib/assembly.xml</descriptor>
          </descriptors>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>single</goal>
            </goals>
            <id>make-assembly</id>
            <phase>package</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
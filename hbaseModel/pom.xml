<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- 父类信息 -->
  <parent>
    <artifactId>IndividualProject</artifactId>
    <groupId>com.gqtian</groupId>
    <version>${revision}</version>
  </parent>

  <!-- 模块信息 -->
  <artifactId>hbaseModel</artifactId>
  <name>hbaseModel</name>
  <description>Hbase示例</description>

  <!-- 打包方式 -->
  <packaging>jar</packaging>
  
  <!-- 依赖控制 -->
  <properties>
  </properties>

  <!-- 依赖版本控制 -->
  <dependencies>
    <dependency>
      <artifactId>commonModel</artifactId>
      <groupId>com.gqtian</groupId>
    </dependency>


    <dependency>
      <artifactId>alihbase-client</artifactId>
      <exclusions>
        <exclusion>
          <artifactId>slf4j-log4j12</artifactId>
          <groupId>org.slf4j</groupId>
        </exclusion>
        <exclusion>
          <artifactId>jdk.tools</artifactId>
          <groupId>jdk.tools</groupId>
        </exclusion>
      </exclusions>
      <groupId>com.aliyun.hbase</groupId>

      <version>1.8.7</version>
    </dependency>
    <dependency>
      <artifactId>rocketmq-spring-boot</artifactId>
      <groupId>org.apache.rocketmq</groupId>
      <scope>compile</scope>
      <version>2.3.3</version>
    </dependency>
  </dependencies>



  <!-- 构建信息-->
  <build>
    <plugins>
      <plugin>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <artifactId>spring-boot-configuration-processor</artifactId>
              <groupId>org.springframework.boot</groupId>
            </exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
        <groupId>org.springframework.boot</groupId>
      </plugin>
      <plugin>
        <artifactId>git-commit-id-maven-plugin</artifactId>
        <groupId>io.github.git-commit-id</groupId>
      </plugin>
      <!-- 统一自动化离线部署包打包插件 -->
      <plugin>
        <groupId>com.github.WhereSome</groupId>
        <artifactId>AbientPackagerMavenPlugin</artifactId>
        <version>1.1.0</version>
        <executions>
          <execution>
            <goals>
              <goal>package-dist</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>


</project>
